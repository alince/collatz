def collatzChunkLoop : Nat -> Nat -> Nat -> Nat × Nat
  | 0, r, p3 => (p3, r)
  | d + 1, r, p3 =>
    if r % 2 == 0 then collatzChunkLoop d (r / 2) p3
    else collatzChunkLoop d ((3 * r + 1) / 2) (3 * p3)

theorem collatzChunkLoop_sound : ∀ (d r p3 q : Nat),
    let pr := collatzChunkLoop d r p3
    pr.1 * q + pr.2 = collatzIter d (2 ^ d * p3 * q + r)
  | 0, r, p3, q => by simp [collatzChunkLoop, collatzIter]
  | d + 1, r, p3, q => by
    have hp2 : 2 ^ (d + 1) * p3 * q + r = 2 * (2 ^ d * p3 * q) + r := by
      rw [Nat.pow_succ]
      calc
        2 ^ d * 2 * p3 * q + r = 2 * 2 ^ d * p3 * q + r := by rw [Nat.mul_comm (2 ^ d) 2]
        _ = 2 * (2 ^ d * p3 * q) + r := by
          rw [Nat.mul_assoc 2 (2 ^ d) p3, Nat.mul_assoc 2 (2 ^ d * p3) q]
    by_cases hr : r % 2 = 0
    · have hb_r : (r % 2 == 0) = true := decide_eq_true hr
      have hb_n : ((2 * (2 ^ d * p3 * q) + r) % 2 == 0) = true := decide_eq_true (by omega)
      simp only [collatzChunkLoop, hb_r, ↓reduceIte, collatzIter, hp2, collatzStep, hb_n]
      have hdiv : (2 * (2 ^ d * p3 * q) + r) / 2 = 2 ^ d * p3 * q + r / 2 := by omega
      rw [hdiv]
      exact collatzChunkLoop_sound d (r / 2) p3 q
    · have hb_r : (r % 2 == 0) = false := decide_eq_false hr
      have hb_n : ((2 * (2 ^ d * p3 * q) + r) % 2 == 0) = false := decide_eq_false (by omega)
      simp only [collatzChunkLoop, hb_r, collatzIter, hp2, collatzStep, hb_n]
      have h3 : (3 * (2 * (2 ^ d * p3 * q) + r) + 1) / 2 =
          2 ^ d * (3 * p3) * q + (3 * r + 1) / 2 := by
        have heq : 3 * (2 * (2 ^ d * p3 * q) + r) + 1 =
            2 * (2 ^ d * (3 * p3) * q) + (3 * r + 1) := by
          calc
            3 * (2 * (2 ^ d * p3 * q) + r) + 1
                = 6 * (2 ^ d * p3 * q) + (3 * r + 1) := by omega
            _ = (2 * 3) * (2 ^ d * p3 * q) + (3 * r + 1) := rfl
            _ = 2 * (3 * (2 ^ d * p3 * q)) + (3 * r + 1) := by rw [Nat.mul_assoc 2 3]
            _ = 2 * ((3 * (2 ^ d * p3)) * q) + (3 * r + 1) := by rw [Nat.mul_assoc 3 (2 ^ d * p3) q]
            _ = 2 * (((2 ^ d * 3) * p3) * q) + (3 * r + 1) := by
                  rw [← Nat.mul_assoc 3 (2 ^ d) p3, Nat.mul_comm 3 (2 ^ d)]
            _ = 2 * (2 ^ d * (3 * p3) * q) + (3 * r + 1) := by rw [Nat.mul_assoc (2 ^ d) 3 p3]
        rw [heq]
        omega
      rw [h3]
      exact collatzChunkLoop_sound d ((3 * r + 1) / 2) (3 * p3) q

def checkLookup6Step : Nat -> Bool
  | 0 => true
  | r + 1 => (lookup6Step r == collatzChunkLoop 6 r 1) && checkLookup6Step r

set_option maxRecDepth 20000 in
theorem lookup6Step_certified : checkLookup6Step 64 = true := by decide

theorem checkLookup6Step_sound : ∀ (n r : Nat),
    checkLookup6Step n = true -> r < n -> lookup6Step r = collatzChunkLoop 6 r 1
  | 0, _, _, hlt => by omega
  | n + 1, r, hok, hlt => by
    unfold checkLookup6Step at hok
    simp only [Bool.and_eq_true, beq_iff_eq] at hok
    by_cases htop : r = n
    · subst htop; exact hok.1
    · exact checkLookup6Step_sound n r hok.2 (by omega)

def fastStep1 (n : Nat) : Nat :=
  match Nat.beq (Nat.mod n 2) 0 with
  | true => Nat.div n 2
  | false => Nat.div (Nat.add (Nat.mul 3 n) 1) 2

theorem fastStep1_eq (n : Nat) : fastStep1 n = collatzStep n := by
  unfold fastStep1 collatzStep
  change (match (n % 2 == 0) with | true => n / 2 | false => (3 * n + 1) / 2) = _
  by_cases h : n % 2 = 0
  · simp [h]
  · have hb : (n % 2 == 0) = false := decide_eq_false h
    simp [hb]

def fastIter1 : Nat -> Nat -> Nat
  | 0, n => n
  | k + 1, n => fastIter1 k (fastStep1 n)

theorem fastIter1_eq : ∀ (k n : Nat), fastIter1 k n = collatzIter k n
  | 0, _ => rfl
  | k + 1, n => by
    simp only [fastIter1, collatzIter, fastStep1_eq]
    exact fastIter1_eq k (collatzStep n)

def fastIter6 : Nat -> Nat -> Nat
  | 0, n => n
  | c + 1, n =>
    let pr := lookup6Step (Nat.mod n 64)
    fastIter6 c (Nat.add (Nat.mul pr.1 (Nat.div n 64)) pr.2)

theorem fastIter6_eq : ∀ (c n : Nat), fastIter6 c n = collatzIter (6 * c) n
  | 0, n => by simp [fastIter6, collatzIter]
  | c + 1, n => by
    simp only [fastIter6]
    change fastIter6 c ((lookup6Step (n % 64)).1 * (n / 64) + (lookup6Step (n % 64)).2) = _
    have hlt : n % 64 < 64 := Nat.mod_lt n (by decide)
    rw [checkLookup6Step_sound 64 (n % 64) lookup6Step_certified hlt]
    have hs := collatzChunkLoop_sound 6 (n % 64) 1 (n / 64)
    dsimp only at hs
    have hdn : 2 ^ 6 * 1 * (n / 64) + n % 64 = n := by
      change 64 * (n / 64) + n % 64 = n
      exact Nat.div_add_mod n 64
    rw [hdn] at hs
    rw [hs, fastIter6_eq c (collatzIter 6 n)]
    rw [show 6 * (c + 1) = 6 + 6 * c by omega, collatzIter_add 6 (6 * c) n]

def oddPeelStep (w p2 p3 : Nat) (kn : Nat × Nat) : Nat × Nat :=
  let k := kn.1
  let n := kn.2
  match Nat.ble w k with
  | false => kn
  | true =>
    match Nat.beq (Nat.mod (Nat.add n 1) p2) 0 with
    | false => kn
    | true => (Nat.sub k w, Nat.sub (Nat.mul p3 (Nat.div (Nat.add n 1) p2)) 1)

theorem oddPeelStep_eq (w p2 p3 : Nat) (hp2 : p2 = 2 ^ w) (hp3 : p3 = 3 ^ w) (kn : Nat × Nat) :
    collatzIter (oddPeelStep w p2 p3 kn).1 (oddPeelStep w p2 p3 kn).2 = collatzIter kn.1 kn.2 := by
  rcases kn with ⟨k, n⟩
  unfold oddPeelStep
  dsimp only
  cases hble : Nat.ble w k with
  | false => rfl
  | true =>
    have hw_le : w ≤ k := Nat.le_of_ble_eq_true hble
    cases hmod : Nat.beq (Nat.mod (Nat.add n 1) p2) 0 with
    | false => rfl
    | true =>
      dsimp only
      subst hp2; subst hp3
      change collatzIter (k - w) (3 ^ w * ((n + 1) / 2 ^ w) - 1) = collatzIter k n
      have hm : (n + 1) % 2 ^ w = 0 := by
        have hb : ((n + 1) % 2 ^ w == 0) = true := hmod
        exact of_decide_eq_true hb
      have hdiv : 2 ^ w * ((n + 1) / 2 ^ w) = n + 1 := by
        have hd := Nat.div_add_mod (n + 1) (2 ^ w)
        rw [hm, Nat.add_zero] at hd
        exact hd
      have hu1 : (n + 1) / 2 ^ w ≥ 1 := by
        cases hq : (n + 1) / 2 ^ w with
        | zero => rw [hq, Nat.mul_zero] at hdiv; omega
        | succ _ => omega
      have hn_eq : n = 2 ^ w * ((n + 1) / 2 ^ w) - 1 := by omega
      conv =>
        rhs
        rw [show k = w + (k - w) by omega, collatzIter_add w (k - w) n, hn_eq,
            odd_run_iter w ((n + 1) / 2 ^ w) hu1]

def fastCollatzIter (k n : Nat) : Nat :=
  let kn1 := oddPeelStep 32 4294967296 1853020188851841 (k, n)
  let kn2 := oddPeelStep 16 65536 43046721 kn1
  let kn3 := oddPeelStep 8 256 6561 kn2
  fastIter1 (Nat.mod kn3.1 6) (fastIter6 (Nat.div kn3.1 6) kn3.2)

theorem fastCollatzIter_eq (k n : Nat) : fastCollatzIter k n = collatzIter k n := by
  unfold fastCollatzIter
  let kn1 := oddPeelStep 32 4294967296 1853020188851841 (k, n)
  let kn2 := oddPeelStep 16 65536 43046721 kn1
  let kn3 := oddPeelStep 8 256 6561 kn2
  change fastIter1 (kn3.1 % 6) (fastIter6 (kn3.1 / 6) kn3.2) = collatzIter k n
  rw [fastIter1_eq, fastIter6_eq, ← collatzIter_add (6 * (kn3.1 / 6)) (kn3.1 % 6) kn3.2]
  rw [Nat.div_add_mod kn3.1 6]
  dsimp [kn3]; rw [oddPeelStep_eq 8 256 6561 rfl rfl kn2]
  dsimp [kn2]; rw [oddPeelStep_eq 16 65536 43046721 rfl rfl kn1]
  dsimp [kn1]; exact oddPeelStep_eq 32 4294967296 1853020188851841 rfl rfl (k, n)

def checkSurvivorBatchFast (n0 : Nat) : List (Nat × Nat) -> Bool
  | [] => true
  | (z, k) :: rest =>
    match Nat.beq (Nat.mod z 2) 1 with
    | false => false
    | true =>
      match Nat.ble (Nat.add n0 1) z with
      | false => false
      | true =>
        match Nat.ble (fastCollatzIter k z) n0 with
        | false => false
        | true => checkSurvivorBatchFast n0 rest

theorem checkSurvivorBatchFast_sound (n0 : Nat) : ∀ (xs : List (Nat × Nat)),
    checkSurvivorBatchFast n0 xs = true -> xs.all (checkSurvivorDrop n0) = true
  | [], _ => rfl
  | (z, k) :: rest, hok => by
    unfold checkSurvivorBatchFast at hok
    cases hm1 : Nat.beq (Nat.mod z 2) 1 with
    | false => rw [hm1] at hok; cases hok
    | true =>
      rw [hm1] at hok
      cases hm2 : Nat.ble (Nat.add n0 1) z with
      | false => rw [hm2] at hok; cases hok
      | true =>
        rw [hm2] at hok
        cases hm3 : Nat.ble (fastCollatzIter k z) n0 with
        | false => rw [hm3] at hok; cases hok
        | true =>
          rw [hm3] at hok
          simp only [List.all_cons, Bool.and_eq_true]
          refine ⟨?_, checkSurvivorBatchFast_sound n0 rest hok⟩
          unfold checkSurvivorDrop
          dsimp only
          simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq]
          have hz_odd : z % 2 = 1 := of_decide_eq_true hm1
          have hz_gt : z > n0 := by
            have hle := Nat.le_of_ble_eq_true hm2
            change n0 + 1 ≤ z at hle
            omega
          have hiter_le : collatzIter k z ≤ n0 := by
            rw [← fastCollatzIter_eq k z]
            exact Nat.le_of_ble_eq_true hm3
          exact ⟨⟨hz_odd, hz_gt⟩, hiter_le⟩

inductive AllBatchesCertified (n0 : Nat) : List (List (Nat × Nat)) -> Prop where
  | nil : AllBatchesCertified n0 []
  | cons {b : List (Nat × Nat)} {bs : List (List (Nat × Nat))} :
      b.all (checkSurvivorDrop n0) = true ->
      AllBatchesCertified n0 bs ->
      AllBatchesCertified n0 (b :: bs)

theorem allBatchesCertified_mem {n0 : Nat} : ∀ {bs : List (List (Nat × Nat))},
    AllBatchesCertified n0 bs -> ∀ b ∈ bs, b.all (checkSurvivorDrop n0) = true
  | [], .nil, _, hb => by cases hb
  | _ :: _, .cons hhd htl, b, hb => by
    simp only [List.mem_cons] at hb
    rcases hb with rfl | hrest
    · exact hhd
    · exact allBatchesCertified_mem htl b hrest

