/-- Fuel-bounded third-most-significant bit `b_{L-3}(n) ∈ {0, 1}` helper (`0` for `n < 4`). -/
def binaryThirdMSBAux : Nat -> Nat -> Nat
  | 0, _ => 0
  | _ + 1, 0 => 0
  | _ + 1, 1 => 0
  | _ + 1, 2 => 0
  | _ + 1, 3 => 0
  | _ + 1, 4 => 0
  | _ + 1, 5 => 1
  | _ + 1, 6 => 0
  | _ + 1, 7 => 1
  | fuel + 1, n + 8 => binaryThirdMSBAux fuel ((n + 8) / 2)

/-- Third-most-significant bit `b_{L-3}(n) ∈ {0, 1}` of `n` (`(n >> (L - 3)) & 1` for `n ≥ 4`). -/
def binaryThirdMSB (n : Nat) : Nat :=
  binaryThirdMSBAux n n

/-- Fuel-bounded MSB-to-LSB adjacent binary `4`-gram `(b3, b2, b1, b0)` counter (`0` for `n < 8`). -/
def binaryFourGramAux (b3 b2 b1 b0 : Nat) : Nat -> Nat -> Nat
  | 0, _ => 0
  | _ + 1, 0 => 0
  | _ + 1, 1 => 0
  | _ + 1, 2 => 0
  | _ + 1, 3 => 0
  | _ + 1, 4 => 0
  | _ + 1, 5 => 0
  | _ + 1, 6 => 0
  | _ + 1, 7 => 0
  | fuel + 1, n + 8 =>
    let m := n + 8
    (if (((m / 8) % 2 == b3) && ((m / 4) % 2 == b2) && ((m / 2) % 2 == b1) && (m % 2 == b0)) then 1 else 0) +
      binaryFourGramAux b3 b2 b1 b0 fuel (m / 2)

/-- Adjacent `(0, 0, 0, 0)` `4`-gram count in the standard MSB-to-LSB binary expansion of `n`. -/
