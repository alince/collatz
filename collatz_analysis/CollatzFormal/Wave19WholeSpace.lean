private def mod2187PairBlockAt (blk : Nat) : List (Nat × Nat) :=
  if Nat.ble (blk + 1) 27 then
    if Nat.ble (blk + 1) 9 then
      match blk with
      | 0 => mod2187NormBlock0
      | 1 => mod2187NormBlock1
      | 2 => mod2187NormBlock2
      | 3 => mod2187NormBlock3
      | 4 => mod2187NormBlock4
      | 5 => mod2187NormBlock5
      | 6 => mod2187NormBlock6
      | 7 => mod2187NormBlock7
      | _ => mod2187NormBlock8
    else if Nat.ble (blk + 1) 18 then
      match blk - 9 with
      | 0 => mod2187NormBlock9
      | 1 => mod2187NormBlock10
      | 2 => mod2187NormBlock11
      | 3 => mod2187NormBlock12
      | 4 => mod2187NormBlock13
      | 5 => mod2187NormBlock14
      | 6 => mod2187NormBlock15
      | 7 => mod2187NormBlock16
      | _ => mod2187NormBlock17
    else
      match blk - 18 with
      | 0 => mod2187NormBlock18
      | 1 => mod2187NormBlock19
      | 2 => mod2187NormBlock20
      | 3 => mod2187NormBlock21
      | 4 => mod2187NormBlock22
      | 5 => mod2187NormBlock23
      | 6 => mod2187NormBlock24
      | 7 => mod2187NormBlock25
      | _ => mod2187NormBlock26
  else
    if Nat.ble (blk + 1) 36 then
      match blk - 27 with
      | 0 => mod2187NormBlock27
      | 1 => mod2187NormBlock28
      | 2 => mod2187NormBlock29
      | 3 => mod2187NormBlock30
      | 4 => mod2187NormBlock31
      | 5 => mod2187NormBlock32
      | 6 => mod2187NormBlock33
      | 7 => mod2187NormBlock34
      | _ => mod2187NormBlock35
    else if Nat.ble (blk + 1) 45 then
      match blk - 36 with
      | 0 => mod2187NormBlock36
      | 1 => mod2187NormBlock37
      | 2 => mod2187NormBlock38
      | 3 => mod2187NormBlock39
      | 4 => mod2187NormBlock40
      | 5 => mod2187NormBlock41
      | 6 => mod2187NormBlock42
      | 7 => mod2187NormBlock43
      | _ => mod2187NormBlock44
    else
      match blk - 45 with
      | 0 => mod2187NormBlock45
      | 1 => mod2187NormBlock46
      | 2 => mod2187NormBlock47
      | 3 => mod2187NormBlock48
      | 4 => mod2187NormBlock49
      | 5 => mod2187NormBlock50
      | 6 => mod2187NormBlock51
      | 7 => mod2187NormBlock52
      | _ => mod2187NormBlock53

private def mod2187RowAtW19 (idx : Nat) : List Nat :=
  unpackRow64W19 (listPairAtCFW19 (mod2187PairBlockAt (idx / 27)) (idx % 27))

/-- Normalized `1458`-state 6-step `Mod 2187` (`3^7`) ternary-carry macro-selector:
    maps `(rem2187, exp1458, sixBits)` to a 6-tuple `(s1, s2, s3, s4, s5, s6)` with
    `12 ≤ s1 + s2 + s3 + s4 + s5 + s6 ≤ 24` (`24 / 6 = 4.0 ≤ 4` positions/bit!). -/
def chooseSixStepTernaryCarry2187 (rem2187 exp1458 sixBits : Nat) :
    Nat × Nat × Nat × Nat × Nat × Nat :=
  let u := uNorm2187W19 rem2187 exp1458
  unpackSixW19 (listNatAtCFW19 (mod2187RowAtW19 (uIdxOf2187W19 u)) (sixBits % 64))

/-- Boolean validator for a 6-step `Mod 2187` branch `(s1..s6)` at normalized state `u2187`. -/
def validSix2187NormBool (u2187 : Nat) (q : Nat × Nat × Nat × Nat × Nat × Nat) : Bool :=
  let s1 := q.1; let s2 := q.2.1; let s3 := q.2.2.1
  let s4 := q.2.2.2.1; let s5 := q.2.2.2.2.1; let s6 := q.2.2.2.2.2
  let tot := s1 + s2 + s3 + s4 + s5 + s6
  let S := 243 + 81 * 2 ^ s6 + 27 * 2 ^ (s5 + s6) + 9 * 2 ^ (s4 + s5 + s6) +
           3 * 2 ^ (s3 + s4 + s5 + s6) + 2 ^ (s2 + s3 + s4 + s5 + s6)
  let rem := ((u2187 * 2 ^ tot) % 2187 + 2187 - S % 2187) % 2187
  Nat.ble 1 s1 && Nat.ble 1 s2 && Nat.ble 1 s3 && Nat.ble 1 s4 && Nat.ble 1 s5 && Nat.ble 1 s6 &&
  Nat.ble 12 tot && Nat.ble tot 24 && Nat.ble (3645 + S) (5 * 2 ^ tot) &&
  ((rem - 1) % 729 == 728)

private def strictlyIncBoolCFW19 : List Nat -> Bool
  | [] => true
  | [_] => true
  | x :: y :: rest => Nat.ble (x + 1) y && strictlyIncBoolCFW19 (y :: rest)

set_option Elab.async false in
private theorem listNatAt_lt_succ_of_strictlyInc_cf_w19 :
    ∀ (xs : List Nat), strictlyIncBoolCFW19 xs = true ->
      ∀ (i j : Nat), i < j -> j < xs.length -> listNatAtCFW19 xs i < listNatAtCFW19 xs j
  | [], _, _, _, _, hj => False.elim (by simp at hj)
  | [_], _, _, _, _, hj => False.elim (by simp at hj; omega)
  | x :: y :: rest, hinc, 0, j + 1, _, hj => by
    rcases Bool.and_eq_true_iff.mp hinc with ⟨hxy_d, htl⟩
    have hxy : x < y := Nat.ble_eq.mp hxy_d
    if hj0 : j = 0 then subst hj0; exact hxy
    else
      have hlt := listNatAt_lt_succ_of_strictlyInc_cf_w19 (y :: rest) htl 0 j (by omega) (by simp at hj; omega)
      exact Nat.lt_trans hxy hlt
  | _ :: y :: rest, hinc, i + 1, j + 1, hij, hj => by
    rcases Bool.and_eq_true_iff.mp hinc with ⟨_, htl⟩
    exact listNatAt_lt_succ_of_strictlyInc_cf_w19 (y :: rest) htl i j (by omega) (by simp at hj; omega)

set_option Elab.async false in
private theorem listNatAt_inj_of_strictlyInc_cf_w19 (xs : List Nat)
    (hinc : strictlyIncBoolCFW19 xs = true) (i j : Nat)
    (hi : i < xs.length) (hj : j < xs.length)
    (heq : listNatAtCFW19 xs i = listNatAtCFW19 xs j) : i = j := by
  if hij : i < j then
    exact False.elim (Nat.ne_of_lt (listNatAt_lt_succ_of_strictlyInc_cf_w19 xs hinc i j hij hj) heq)
  else if hji : j < i then
    exact False.elim (Nat.ne_of_lt (listNatAt_lt_succ_of_strictlyInc_cf_w19 xs hinc j i hji hi) heq.symm)
  else omega

set_option Elab.async false in
private theorem listNatAt_mem_cf_w19 :
    ∀ (xs : List Nat) (k : Nat), k < xs.length -> listNatAtCFW19 xs k ∈ xs
  | [], _, hk => False.elim (by simp at hk)
  | _ :: _, 0, _ => List.Mem.head _
  | _ :: xs, k + 1, hk => List.mem_cons_of_mem _ (listNatAt_mem_cf_w19 xs k (by simp at hk; omega))

private def checkRow64TailW19 (u prev rem : Nat) : List Nat -> Bool
  | [] => rem == 0
  | p :: ps =>
    (rem != 0) && Nat.ble (prev + 1) p && validSix2187NormBool u (unpackSixW19 p) &&
      checkRow64TailW19 u p (rem - 1) ps

set_option Elab.async false in
private theorem checkRow64TailW19_spec :
    ∀ (xs : List Nat) (u prev rem : Nat),
      checkRow64TailW19 u prev rem xs = true ->
      xs.length = rem ∧
      strictlyIncBoolCFW19 (prev :: xs) = true ∧
      (∀ p ∈ xs, validSix2187NormBool u (unpackSixW19 p) = true)
  | [], _, _, rem, h => by
    unfold checkRow64TailW19 at h
    exact ⟨(beq_iff_eq.mp h).symm, rfl, fun _ hm => False.elim (by cases hm)⟩
  | p :: ps, u, prev, rem, h => by
    unfold checkRow64TailW19 at h
    rcases Bool.and_eq_true_iff.mp h with ⟨hc1, htl⟩
    rcases Bool.and_eq_true_iff.mp hc1 with ⟨hc2, hval_p⟩
    rcases Bool.and_eq_true_iff.mp hc2 with ⟨hrem_ne, hlt_p⟩
    have hrem_pos : rem ≠ 0 := bne_iff_ne.mp hrem_ne
    rcases checkRow64TailW19_spec ps u p (rem - 1) htl with ⟨hlen_ps, hinc_ps, hall_ps⟩
    refine ⟨by simp only [List.length_cons, hlen_ps]; omega,
            by unfold strictlyIncBoolCFW19; exact Bool.and_eq_true_iff.mpr ⟨hlt_p, hinc_ps⟩,
            ?_⟩
    intro x hx; rcases List.mem_cons.mp hx with rfl | hmem
    · exact hval_p
    · exact hall_ps x hmem

private def checkRow64FastW19 (u : Nat) : List Nat -> Bool
  | [] => false
  | p0 :: ps => validSix2187NormBool u (unpackSixW19 p0) && checkRow64TailW19 u p0 63 ps

set_option Elab.async false in
private theorem checkRow64FastW19_spec (u : Nat) (row : List Nat)
    (h : checkRow64FastW19 u row = true) :
    row.length = 64 ∧
    strictlyIncBoolCFW19 row = true ∧
    (∀ b : Nat, b < 64 -> validSix2187NormBool u (unpackSixW19 (listNatAtCFW19 row b)) = true) := by
  cases row with
  | nil => cases h
  | cons p0 ps =>
    unfold checkRow64FastW19 at h
    rcases Bool.and_eq_true_iff.mp h with ⟨hv0, htl⟩
    rcases checkRow64TailW19_spec ps u p0 63 htl with ⟨hlen_ps, hinc, hall_ps⟩
    have hlen : (p0 :: ps).length = 64 := by simp only [List.length_cons, hlen_ps]
    refine ⟨hlen, hinc, ?_⟩
    intro b hb
    have hmem := listNatAt_mem_cf_w19 (p0 :: ps) b (hlen ▸ hb)
    rcases List.mem_cons.mp hmem with h0 | hm_ps
    · rw [h0]; exact hv0
    · exact hall_ps _ hm_ps

private def pow2Small24W19 (e : Nat) : Nat :=
  if Nat.ble (e + 1) 13 then
    match e with
    | 0 => 1 | 1 => 2 | 2 => 4 | 3 => 8 | 4 => 16 | 5 => 32 | 6 => 64
    | 7 => 128 | 8 => 256 | 9 => 512 | 10 => 1024 | 11 => 2048 | _ => 4096
  else
    match e - 13 with
    | 0 => 8192 | 1 => 16384 | 2 => 32768 | 3 => 65536 | 4 => 131072 | 5 => 262144
    | 6 => 524288 | 7 => 1048576 | 8 => 2097152 | 9 => 4194304 | 10 => 8388608
    | _ => 16777216

set_option Elab.async false in
private theorem pow2Small24W19_eq (e : Nat) (he : e ≤ 24) : pow2Small24W19 e = 2 ^ e := by
  if h13 : e < 13 then
    match e, h13 with
